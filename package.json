{
  "name": "cicero-hoard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local workspace that turns a brief and documents into an editable presentation: outline, slides, review, theme and export, for assistants over MCP.",
  "scripts": {
    "client": "vite",
    "build": "node scripts/build.mjs",
    "dev": "python scripts/dev.py",
    "start": "python -m cicero_hoard",
    "open": "python scripts/launch.py",
    "test": "python -m pytest -q",
    "mcp": "python mcp_server.py"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reveal.js": "^6.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
